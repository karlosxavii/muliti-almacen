SECRET_KEY=cambia-esta-clave-en-produccion
FLASK_CONFIG=development
APP_NAME=Bodega Control

# MySQL local
DATABASE_URL=mysql+pymysql://usuario:clave@127.0.0.1:3306/multi_almacen?charset=utf8mb4

# SQLite (alternativa para desarrollo)
# DATABASE_URL=sqlite:///instance/bodega.db

# Con migraciones, dejar estas opciones en false.
# Crear el administrador con: flask seed-admin
AUTO_CREATE_TABLES=false
AUTO_SEED_ADMIN=false
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_NAME=Administrador

HOST=127.0.0.1
PORT=8000
ITEMS_PER_PAGE=20
